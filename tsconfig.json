{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": true,
    "declaration": true,
    "esModuleInterop": true,
    "incremental": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "sourceMap": true,
    "target": "es2017",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },
  "include": [
    "src"
  ]
}
